# ============================================
# WallZ Awareness Demo – Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/awareness_demo?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@YOUR_CLUSTER.mongodb.net/awareness_demo?retryWrites=true&w=majority

# Server port (default 3000)
PORT=3000

# Optional: comma-separated allowed origins for CORS
# Leave empty to allow all origins (useful for local demos)
# CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
